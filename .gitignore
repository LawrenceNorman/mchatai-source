# Scaffold build artifacts (each scaffold resolves its own deps locally)
frameworks/**/.build/
frameworks/**/.swiftpm/
frameworks/**/DerivedData/
frameworks/**/target/
frameworks/**/Package.resolved

# Swift compiler intermediates (anywhere — defense in depth, hardened 2026-04-25)
**/.build/
**/.swiftpm/
**/DerivedData/
*.swiftdeps
*.swiftmodule
*.swiftdoc
*.pcm
*.dia
*.o
*.d
*.sample

# Catalog/data backup files (cleanup utilities sometimes write these)
*.bak-*
*.bak
backup-*.json
*-backup-*.json

# Editor scratch
.tmp/
*.tmp
*.swp.*

# LoopStar pack audio is hosted on GCS (gs://mchatai-downloads/loopstar/packs/)
# and fetched on demand by the app -- keep the multi-hundred-MB WAVs out of git.
frameworks/loopstar/**/*.wav

# Dataset working files never belong in this repo — it is public, every macOS
# user clones it, and git content is unmeterable and unrevocable without a
# history rewrite. Only the small first-party pack + index ship here; corpora,
# OCR, pipeline scripts and review output live outside git, and large or paid
# packs are served from platform storage. See places/README.md (Phase SL.5).
places/landmarks/
