            { "bar": 0, "text": "The Camptown ladies sing this song" },
            { "bar": 2, "text": "Doo-dah, doo-dah" },
            { "bar": 4, "text": "The Camptown racetrack five miles long" },
            { "bar": 6, "text": "Oh, doo-dah day" }
          ],
          [
            { "bar": 0, "text": "I come down there with my hat caved in" },
            { "bar": 2, "text": "Doo-dah, doo-dah" },
            { "bar": 4, "text": "I go back home with a pocket full of tin" },
            { "bar": 6, "text": "Oh, doo-dah day" }
          ]
