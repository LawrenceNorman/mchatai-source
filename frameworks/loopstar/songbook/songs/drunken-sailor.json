        "pd": {
          "lyricist": "Traditional",
          "basis": "traditional",
          "detail": "Anonymous English merchant-service shanty text with no identifiable author; the song is referenced in print from 1839 and the words were in wide oral circulation among crews long before 1900.",
          "sourceEdition": "Whall, 'Ships, Sea Songs and Shanties', 1910, p. 107 ('Early in the Morning'); Terry, 'The Shanty Book' Part I, 1921, No. 14"
        },
        "notes": "Two stanzas only, transcribed from the pre-1930 printings and nowhere else. The call is Whall's reading ('a drunken sailor'); Terry prints 'the drunken sailor'. The long-boat verse is Terry No. 14 verse 2 verbatim. Terry's remaining verses are the punishment verses (pull out the plug, the scuppers and hose-pipe, the running bowline, the taffrail); they are left out for length, not for offence, and no offensive verse was carried in from any printing. The call is sung three times against the crew answer; in this split verse/chorus encoding the caller takes all three statements and the closing tag line.",
        "stanzas": [
          [
            { "bar": 0, "text": "What shall we do with a drunken sailor" },
            { "bar": 2, "text": "What shall we do with a drunken sailor" },
            { "bar": 4, "text": "What shall we do with a drunken sailor" },
            { "bar": 6, "text": "Early in the morning" }
          ],
          [
            { "bar": 0, "text": "Put him in the long-boat until he's sober" },
            { "bar": 2, "text": "Put him in the long-boat until he's sober" },
            { "bar": 4, "text": "Put him in the long-boat until he's sober" },
            { "bar": 6, "text": "Early in the morning" }
          ]
        ]
      }
