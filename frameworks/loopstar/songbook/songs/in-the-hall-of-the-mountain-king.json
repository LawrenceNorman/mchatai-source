  "pd": {
    "basis": "author-died-pre-1930",
    "detail": "Edvard Grieg died in 1907. The Peer Gynt incidental music Op. 23 was written in 1875 and Suite No. 1 Op. 46 was published in 1888, so the composition is free worldwide.",
    "sourceEdition": "Grieg, Peer Gynt Suite No. 1 Op. 46 No. 4; theme as carried by cellos, basses and bassoons in B minor, alla marcia e molto marcato, quarter = 138, checked against a public-domain melodic transcription of the orchestral score",
    "notes": "Melody and harmony only; the Peer Gynt play text is not carried."
  },
  "key": "Bm",
