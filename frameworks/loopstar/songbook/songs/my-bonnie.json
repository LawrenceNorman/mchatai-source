  "id": "my-bonnie",
  "title": "My Bonnie Lies Over the Ocean",
  "composer": "Traditional (Scottish)",
  "year": 1881,
  "origin": "Scottish folk song; first published in the United States in 1881 as 'Bring Back My Bonnie to Me'.",
  "tags": ["folk", "scottish", "waltz", "3/4", "singalong"],
  "styleHints": ["folk", "lofi", "soul"],
