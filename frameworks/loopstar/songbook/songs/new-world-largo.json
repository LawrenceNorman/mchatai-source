      "lyrics": {
        "pd": {
          "lyricist": "William Arms Fisher",
          "basis": "published-pre-1930",
          "detail": "Fisher, a pupil of Dvorak, wrote these words to his teacher's Largo theme and published them as the song 'Goin' Home' in 1922; the text is his own invention, not a quotation of any spiritual.",
          "sourceEdition": "Fisher, William Arms, 'Goin' Home' (Oliver Ditson Co., Boston, 1922), voice-and-piano edition"
        },
        "notes": "Only the opening quatrain is carried. Fisher's later verses and the words he set to the middle strain are omitted because the encoder cannot transcribe them with certainty, and a half-remembered verse is worse than none. Theme B, the Reprise and the Outro therefore carry no words. Nothing was dropped for offensive content - the song has no minstrel-dialect verses; the eye-dialect spellings here (goin', jes', a-goin') are Fisher's own printed text and are kept verbatim. The form states Theme A twice and only one stanza is carried, so both occurrences sing it and no form entry sets 'stanza'. The words are laid over Dvorak's orchestral theme, which is the same tune Fisher set.",
        "stanzas": [
          [
            {
              "bar": 0,
              "text": "Goin' home, goin' home,"
            },
            {
              "bar": 2,
              "text": "I'm a-goin' home,"
            },
            {
              "bar": 4,
              "text": "Quiet-like, some still day,"
            },
            {
              "bar": 6,
              "text": "I'm jes' goin' home."
            }
          ]
        ]
      }
    },
