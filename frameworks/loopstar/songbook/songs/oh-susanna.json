      "lyrics": {
        "pd": {
          "lyricist": "Stephen Collins Foster",
          "basis": "published-pre-1930",
          "detail": "Foster wrote the words as well as the music; the text was first printed in the United States in 1848 and Foster died in 1864, so the words are long out of copyright in their own right.",
          "sourceEdition": "Foster, 'Oh! Susanna', W. C. Peters, Cincinnati, 1848 song sheet; dialect spellings normalised to the standard modern singable text"
        },
        "notes": "The 1848 printing has four verses; its second and fourth verses carry a racial slur that no modern edition prints and both are omitted here. Stanza 1 below is the first verse of that printing and stanza 2 is the third. The eye-dialect spellings of the 1848 sheet are normalised, which is the only change made to the retained words.",
        "stanzas": [
          [
            { "bar": 0, "text": "I come from Alabama with my banjo on my knee" },
            { "bar": 2, "text": "I'm going to Louisiana, my true love for to see" },
            { "bar": 4, "text": "It rained all night the day I left, the weather it was dry" },
            { "bar": 6, "text": "The sun so hot I froze to death, Susanna, don't you cry" }
          ],
          [
            { "bar": 0, "text": "I had a dream the other night when everything was still" },
            { "bar": 2, "text": "I thought I saw Susanna a-coming down the hill" },
            { "bar": 4, "text": "The buckwheat cake was in her mouth, the tear was in her eye" },
            { "bar": 6, "text": "Says I, I'm coming from the south, Susanna, don't you cry" }
          ]
        ]
      }
