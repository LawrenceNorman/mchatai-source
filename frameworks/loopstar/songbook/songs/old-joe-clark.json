      "lyrics": {
        "pd": {
          "lyricist": "Traditional",
          "basis": "traditional",
          "detail": "Anonymous southern mountain dance-song text with no identifiable author, collected from oral tradition in East Tennessee and Mississippi and printed without attribution to any writer.",
          "sourceEdition": "Perrow, 'Songs and Rhymes from the South', Journal of American Folk-Lore, vol. 25, no. 96, 1912, p. 152, no. 5 'Old Joe Clark', versions A and B"
        },
        "notes": "Two stanzas, transcribed from the 1912 collected texts and nowhere else; the many modern floating verses attached to this tune are somebody's later edit and are not carried. Stanza 1 is Perrow's version A verse (East Tennessee), stanza 2 his version B (Mississippi). Perrow's field spelling is set in standard orthography, which changes no word and no sung syllable. The A strain is the low verse strain: four sung lines over four two-bar phrases, on bars 0, 2, 4 and 6. The two-eighth low-5 pickup that opens each line sits at the end of the previous bar and is carried in the intro for line 1, so every line is pinned to the downbeat its first stressed syllable lands on.",
        "stanzas": [
          [
            { "bar": 0, "text": "Old Joe Clark he killed a man" },
            { "bar": 2, "text": "And buried him in the sand" },
            { "bar": 4, "text": "Said if he had another chance" },
            { "bar": 6, "text": "He'd kill another man" }
          ],
          [
            { "bar": 0, "text": "Old Joe Clark, he is a sharp" },
            { "bar": 2, "text": "Creeping through the timber" },
            { "bar": 4, "text": "Old Joe Clark shot at a lark" },
            { "bar": 6, "text": "And killed my wife in the window" }
          ]
        ]
      }
    },
