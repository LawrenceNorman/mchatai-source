      "lyrics": {
        "pd": {
          "lyricist": "Traditional",
          "basis": "traditional",
          "detail": "Anonymous southern mountain dance-song refrain with no identifiable author, collected from oral tradition in East Tennessee and printed without attribution to any writer.",
          "sourceEdition": "Perrow, 'Songs and Rhymes from the South', Journal of American Folk-Lore, vol. 25, no. 96, 1912, p. 152, no. 5 'Old Joe Clark', version A refrain"
        },
        "notes": "The refrain as collected in 1912, word for word, with Perrow's 'Good-by' spelled out in full and no other change; the 'fare thee well' wording most people know from twentieth-century recordings is a later reading and is deliberately not used. One stanza, because the refrain sings the same words both times it comes round. The B strain is the high answering strain: four short sung lines over four two-bar phrases, on bars 0, 2, 4 and 6, each pinned to the downbeat its stressed syllable lands on.",
        "stanzas": [
          [
            { "bar": 0, "text": "Good-bye, old Joe Clark" },
