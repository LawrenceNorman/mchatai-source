      "lyrics": {
        "pd": {
          "lyricist": "Traditional",
          "basis": "traditional",
          "detail": "Anonymous Appalachian courting-song refrain with no identifiable author, collected from oral tradition among Kentucky mountain singers and printed with no writer credited.",
          "sourceEdition": "Perrow, 'Songs and Rhymes from the South', Journal of American Folk-Lore, vol. 28, no. 108, 1915, pp. 182-183, no. 44 'Shady Grove', version B refrain"
        },
        "notes": "The refrain exactly as collected in 1915, version B. Everything here comes from that one printed version, so no two variants are spliced together; the widely sung twentieth-century revival wordings are later edits and are not carried. One stanza, because the refrain sings the same words each time it comes round. Four sung lines over four two-bar phrases, on bars 0, 2, 4 and 6; the two-eighth pickup opening each line sits at the end of the previous bar, and line 1's is carried in the intro.",
        "stanzas": [
          [
            { "bar": 0, "text": "Shady grove, my little love" },
            { "bar": 2, "text": "Shady grove, my darling" },
            { "bar": 4, "text": "Shady grove, my little love" },
            { "bar": 6, "text": "Going back to Harlan" }
          ]
        ]
      }
    },
