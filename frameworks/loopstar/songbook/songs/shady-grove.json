      "lyrics": {
        "pd": {
          "lyricist": "Traditional",
          "basis": "traditional",
          "detail": "Anonymous Appalachian courting-song verses with no identifiable author, collected from oral tradition among Kentucky mountain singers and printed with no writer credited.",
          "sourceEdition": "Perrow, 'Songs and Rhymes from the South', Journal of American Folk-Lore, vol. 28, no. 108, 1915, pp. 182-183, no. 44 'Shady Grove', version B verses"
        },
        "notes": "Two of version B's floating verses, transcribed from the 1915 printing and taken from that same version as the refrain, so nothing is spliced across variants. Perrow's remaining B verses are dropped for length only. Version A carries a verse ending in an oath, which is not used. Perrow's field spelling is set in standard orthography, which changes no word and no sung syllable. Four sung lines over four two-bar phrases, on bars 0, 2, 4 and 6, each pinned to the downbeat its stressed syllable lands on rather than to the bar its pickup sits in.",
        "stanzas": [
          [
            { "bar": 0, "text": "Fly around, my blue-eyed girl" },
            { "bar": 2, "text": "Fly around, my daisy" },
            { "bar": 4, "text": "Fly around, my blue-eyed girl" },
            { "bar": 6, "text": "Nearly drive me crazy" }
          ],
          [
            { "bar": 0, "text": "Apples in the summer" },
            { "bar": 2, "text": "Peaches in the fall" },
            { "bar": 4, "text": "If I can't marry the girl I want" },
            { "bar": 6, "text": "I won't have none at all" }
          ]
        ]
      }
