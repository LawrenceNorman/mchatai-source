      "lyrics": {
        "pd": {
          "lyricist": "Traditional",
          "basis": "traditional",
          "detail": "Anonymous American bad-man ballad text with no identifiable author, sung about the 1895 St. Louis killing and collected from oral tradition across the lower South with no writer credited.",
          "sourceEdition": "Odum and Johnson, 'The Negro and His Songs', University of North Carolina Press, 1925, pp. 196-197, 'Stagolee', the three opening couplets"
        },
        "notes": "The three couplets Odum and Johnson print with the refrain attached, transcribed from the 1925 collected text and nowhere else. The 1958 rhythm-and-blues rewrite that made the song famous a second time is separately in copyright and none of its wording is carried. Odum and Johnson's transcribed eye-dialect spelling is set in standard orthography here, which changes no word and no sung syllable. The later killing and courtroom couplets are dropped for length. Each stanza is a couplet plus the fixed refrain over the three four-bar phrases of the twelve-bar chorus, so the lines fall on bars 0, 4 and 8; the refrain is the same every stanza by design.",
        "stanzas": [
          [
            { "bar": 0, "text": "Stagolee, Stagolee, what's that in your grip?" },
            { "bar": 4, "text": "Nothing but my Sunday clothes, I'm going to take a trip" },
            { "bar": 8, "text": "Oh, that man, bad man, Stagolee done come" }
          ],
          [
            { "bar": 0, "text": "Stagolee, Stagolee, where you been so long?" },
            { "bar": 4, "text": "I been out on the battlefield shooting and having fun" },
            { "bar": 8, "text": "Oh, that man, bad man, Stagolee done come" }
          ],
          [
            { "bar": 0, "text": "Stagolee was a bully man, and everybody knowed" },
            { "bar": 4, "text": "When they seed Stagolee coming to give Stagolee the road" },
            { "bar": 8, "text": "Oh, that man, bad man, Stagolee done come" }
          ]
        ]
      }
    },
