      "lyrics": {
        "pd": {
          "lyricist": "Traditional",
          "basis": "traditional",
          "detail": "Anonymous American revival hymn text with no identifiable author, circulating in shape-note and camp-meeting songsters from the middle of the nineteenth century and printed in the United States long before 1930.",
          "sourceEdition": "Common-stock nineteenth-century revival-songster text; earliest documented printing Joseph Bever, 'The Christian Songster', 1858, and in print in the United States repeatedly before 1930"
        },
        "notes": "Two of the common-stock verses are carried; the further verses that some printings add are not encoded. The wording follows the nineteenth-century printed reading rather than the folk-revival reading heard on modern recordings. Nothing offensive appears in this text and no verse was dropped on those grounds.",
        "stanzas": [
          [
            { "bar": 0, "text": "I am a poor wayfaring stranger" },
            { "bar": 2, "text": "While traveling through this world of woe" },
            { "bar": 4, "text": "Yet there's no sickness, toil, nor danger" },
            { "bar": 6, "text": "In that bright world to which I go" }
          ],
          [
            { "bar": 0, "text": "I know dark clouds will gather round me" },
            { "bar": 2, "text": "I know my way is rough and steep" },
            { "bar": 4, "text": "Yet beauteous fields lie just before me" },
            { "bar": 6, "text": "Where God's redeemed their vigils keep" }
          ]
        ]
      }
    },
