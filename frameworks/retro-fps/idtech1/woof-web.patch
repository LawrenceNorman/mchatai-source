diff --git a/CMakeLists.txt b/CMakeLists.txt
index 32986e9..cb84fce 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -118,9 +118,26 @@ check_c_source_compiles(
 set(CMAKE_FIND_FRAMEWORK NEVER)
 
 # Library requirements.
-find_package(SDL3 3.4.0 REQUIRED)
-find_package(SDL3_net REQUIRED)
-find_package(OpenAL REQUIRED)
+if(EMSCRIPTEN)
+    # Browser build: SDL3 comes from Emscripten's port, OpenAL from its Web
+    # Audio implementation, and networking is stubbed (src/nw_web.c).
+    add_library(SDL3::SDL3 INTERFACE IMPORTED)
+    target_compile_options(SDL3::SDL3 INTERFACE "--use-port=sdl3")
+    target_link_options(SDL3::SDL3 INTERFACE "--use-port=sdl3")
+    add_library(SDL3_net::SDL3_net INTERFACE IMPORTED)
+    add_library(OpenAL::OpenAL INTERFACE IMPORTED)
+    # OpenAL Soft's public headers (web/AL) declare the extension constants and
+    # function-pointer types Woof compiles against; Emscripten's own headers
+    # stop at core OpenAL 1.1. Extensions are looked up at run time and come
+    # back absent, which Woof already handles.
+    target_include_directories(OpenAL::OpenAL INTERFACE "${CMAKE_SOURCE_DIR}/web/AL")
+    target_link_options(OpenAL::OpenAL INTERFACE "-lopenal")
+    set(OPENAL_VERSION_STRING "1.1")
+else()
+    find_package(SDL3 3.4.0 REQUIRED)
+    find_package(SDL3_net REQUIRED)
+    find_package(OpenAL REQUIRED)
+endif()
 if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
     find_package(ALSA REQUIRED)
 endif()
@@ -223,6 +240,8 @@ add_subdirectory(opl)
 add_subdirectory(textscreen)
 add_subdirectory(third-party)
 add_subdirectory(src)
-add_subdirectory(setup)
-add_subdirectory(man)
-add_subdirectory(cmake/packaging)
+if(NOT EMSCRIPTEN)
+    add_subdirectory(setup)
+    add_subdirectory(man)
+    add_subdirectory(cmake/packaging)
+endif()
diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index b5e1455..b67d474 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -202,11 +202,35 @@ set(WOOF_SOURCES
     z_zone.c               z_zone.h
 )
 
+if(EMSCRIPTEN)
+    list(REMOVE_ITEM WOOF_SOURCES nw_sdl.c)
+    list(APPEND WOOF_SOURCES nw_web.c)
+endif()
+
 # Standard target definition
 add_executable(woof ${WOOF_SOURCES})
 target_woof_settings(woof)
 target_include_directories(woof PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/../")
 
+if(EMSCRIPTEN)
+    # The page hands over the wasm bytes and the WAD files itself (preRun +
+    # FS.writeFile), so nothing is fetched: installed mini-apps run on file://.
+    target_link_options(woof PRIVATE
+        "-sMODULARIZE=1"
+        "-sEXPORT_NAME=createWoof"
+        "-sENVIRONMENT=web"
+        "-sALLOW_MEMORY_GROWTH=1"
+        "-sINITIAL_MEMORY=67108864"
+        "-sSTACK_SIZE=4194304"
+        "-sDYNAMIC_EXECUTION=0"
+        "-sFORCE_FILESYSTEM=1"
+        "-sEXPORTED_RUNTIME_METHODS=FS,callMain"
+        # Without wasmBinary listed here a release build ignores the bytes the
+        # page supplies and fetches woof.wasm, which fails on file://.
+        "-sINCOMING_MODULE_JS_API=canvas,wasmBinary,arguments,preRun,postRun,print,printErr,onRuntimeInitialized,onAbort,locateFile"
+    )
+endif()
+
 if(WIN32)
     # Stamp out and compile resource file on Windows.
     configure_file(resource.rc.in "${CMAKE_CURRENT_BINARY_DIR}/resource.rc")
@@ -306,6 +330,7 @@ if(WOOF_STRICT)
 endif()
 
 # Setup tool
+if(NOT EMSCRIPTEN)
 set(SETUP_SOURCES
     d_iwad.c                d_iwad.h
     i_exit.c                i_exit.h
@@ -346,6 +371,7 @@ target_link_libraries(
 if(MSVC)
     target_link_options(woof-setup PRIVATE "/MANIFEST:NO")
 endif()
+endif()
 
 # Base file
 add_dependencies(woof woof-base)
@@ -375,6 +401,6 @@ if(WIN32)
     else()
         install(TARGETS woof woof-setup RUNTIME DESTINATION .)
     endif()
-else()
+elseif(NOT EMSCRIPTEN)
     install(TARGETS woof woof-setup RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
 endif()
