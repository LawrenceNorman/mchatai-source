diff --git a/src/i_oalmusic.c b/src/i_oalmusic.c
index 7c133be..2049f9a 100644
--- a/src/i_oalmusic.c
+++ b/src/i_oalmusic.c
@@ -375,7 +375,13 @@ boolean I_OAL_InitStream(void)
     alGenBuffers(NUM_BUFFERS, player.buffers);
     alGenSources(1, &player.source);
 
+#ifdef __EMSCRIPTEN__
+    // The web OpenAL follows the 1.1 spec and rejects AL_MAX_GAIN above 1;
+    // the rejected call would leave an error that fails StartPlayer later.
+    alSourcef(player.source, AL_MAX_GAIN, 1.0f);
+#else
     alSourcef(player.source, AL_MAX_GAIN, 10.0f);
+#endif
 
     // Set parameters so mono sources play out the front-center speaker and
     // won't distance attenuate.
@@ -512,6 +518,12 @@ static void I_OAL_PlaySong(void *handle, boolean looping)
 
     player.looping = looping;
 
+#ifdef __EMSCRIPTEN__
+    // With no player thread, queue the first buffers before playing: the web
+    // OpenAL refuses to play a source whose queue is empty.
+    StartPlayer();
+#endif
+
     if (!player.paused)
     {
         alSourcePlay(player.source);
@@ -523,8 +535,21 @@ static void I_OAL_PlaySong(void *handle, boolean looping)
     }
 
     SDL_SetAtomicInt(&player_thread_running, 1);
+#ifndef __EMSCRIPTEN__
     player_thread_handle = SDL_CreateThread(PlayerThread, NULL, NULL);
+#endif
+}
+
+#ifdef __EMSCRIPTEN__
+void I_OAL_PumpStream(void)
+{
+    if (music_initialized && SDL_GetAtomicInt(&player_thread_running)
+        && !UpdatePlayer())
+    {
+        SDL_SetAtomicInt(&player_thread_running, 0);
+    }
 }
+#endif
 
 static void I_OAL_StopSong(void *handle)
 {
@@ -536,7 +561,9 @@ static void I_OAL_StopSong(void *handle)
     alSourceStop(player.source);
 
     SDL_SetAtomicInt(&player_thread_running, 0);
+#ifndef __EMSCRIPTEN__
     SDL_WaitThread(player_thread_handle, NULL);
+#endif
 
     if (alGetError() != AL_NO_ERROR)
     {
diff --git a/src/i_oalsound.c b/src/i_oalsound.c
index cd56810..ecb192b 100644
--- a/src/i_oalsound.c
+++ b/src/i_oalsound.c
@@ -252,7 +252,13 @@ void I_OAL_ResetSource2D(int channel)
     alSourcef(oal->sources[channel], AL_ROLLOFF_FACTOR, 0.0f);
     alSourcei(oal->sources[channel], AL_SOURCE_RELATIVE, AL_TRUE);
     alSourcei(oal->sources[channel], AL_REFERENCE_DISTANCE, 0);
+#ifdef __EMSCRIPTEN__
+    // A Web Audio PannerNode throws on maxDistance <= 0. With rolloff at 0
+    // the distance has no audible effect, so any positive value will do.
+    alSourcei(oal->sources[channel], AL_MAX_DISTANCE, 1);
+#else
     alSourcei(oal->sources[channel], AL_MAX_DISTANCE, 0);
+#endif
 }
 
