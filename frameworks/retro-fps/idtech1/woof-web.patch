@@ -259,6 +264,12 @@ void D_Display (void)
 
   wipe = false;
 
+#ifdef __EMSCRIPTEN__
+  // A wipe runs its own frame loop until it finishes, and a browser page
+  // cannot present frames from inside one. Change state without a wipe.
+  wipegamestate = gamestate;
+#endif
+
   // save the current screen if about to wipe
   if (gamestate != wipegamestate)
     {
@@ -1519,6 +1530,17 @@ void D_SetSavegameDirectory(void)
 
 #undef SET_DIR
 
+#ifdef __EMSCRIPTEN__
+static void D_WebFrame(void)
+{
+  I_StartFrame();
+  TryRunTics();
+  if (screenvisible)
+    D_Display();
+  I_OAL_PumpStream();
+}
+#endif
+
 //
 // D_DoomMain
 //
@@ -2418,6 +2440,12 @@ void D_DoomMain(void)
 
   D_StartGameLoop();
 
+#ifdef __EMSCRIPTEN__
+  // The browser owns the loop: one iteration per animation frame. TryRunTics
+  // only waits for a tic when the framerate is capped, so keep it uncapped.
+  uncapped = true;
+  emscripten_set_main_loop(D_WebFrame, 0, 1);
+#else
   for (;;)
     {
       // frame syncronous IO operations
@@ -2429,6 +2457,7 @@ void D_DoomMain(void)
       if (screenvisible)
         D_Display();
     }
+#endif
 }
 
