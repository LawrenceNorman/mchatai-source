        {
          "id": "sc1-sh2",
          "beats": [
            {
              "type": "line",
              "character": "Ilsabill",
              "text": "You caught a MAGIC PRINCE and asked for NOTHING? Look at this hovel! The pig lives better than we do.",
              "duration": 8.04,
              "pose": "point"
            },
            {
              "type": "line",
              "character": "Fisherman",
              "text": "It seemed rude to haggle with royalty, dear.",
              "duration": 3.43,
              "pose": "shrug"
            },
            {
              "type": "line",
              "character": "Ilsabill",
              "text": "Go back. Tell him your wife will have a fine palace, and be queen of all the land. GO.",
              "duration": 7.66,
              "pose": "point"
            }
          ],
          "camera": {
            "from": {
              "x": -0.43,
