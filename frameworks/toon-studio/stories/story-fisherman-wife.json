            {
              "type": "line",
              "character": "The Fish",
              "text": "Pray let me live, fisherman. I am no flounder — I am an enchanted prince. Put me back in the water.",
              "duration": 8.43,
              "pose": "talk"
            },
            {
              "type": "line",
              "character": "Fisherman",
              "text": "Say no more. A fish that can talk may certainly swim where he pleases.",
              "duration": 5.73,
              "pose": "shrug"
            },
            {
              "type": "sound",
              "sound": "splash",
              "gain": 0.6
