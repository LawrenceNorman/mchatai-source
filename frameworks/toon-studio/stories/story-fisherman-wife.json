          "beats": [
            {
              "type": "line",
              "character": "Fisherman",
              "text": "O man of the sea, hearken to me! My wife Ilsabill will have her own will, and has sent me to beg a boon of thee!",
              "duration": 10.35,
              "pose": "talk"
            },
            {
              "type": "sound",
              "sound": "magic",
              "gain": 0.7
            },
            {
              "type": "line",
              "character": "The Fish",
              "text": "Go home. She is queen in her palace already.",
