          "beats": [
            {
              "type": "line",
              "character": "Ilsabill",
              "text": "The sun rose this morning without asking me. I will be lord of the sun and the moon. Go and tell him.",
              "duration": 8.81,
              "pose": "point"
            },
            {
              "type": "line",
              "character": "Fisherman",
              "text": "Wife — no. The sea was BLACK when I asked for the palace. It smelled of storm. He will not—",
              "duration": 8.04,
              "pose": "shrug"
            },
            {
              "type": "line",
              "character": "Ilsabill",
              "text": "GO.",
