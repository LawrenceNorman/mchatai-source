      "shots": [
        {
          "id": "sc1-sh1",
          "beats": [
            {
              "type": "line",
              "character": "Narrator",
              "text": "Carnival night. The one night of the year when every insult wears a smile.",
              "duration": 5.73
            },
            {
              "type": "pause",
              "duration": 0.3
            },
            {
              "type": "line",
              "character": "Montresor",
              "text": "Fortunato! The very man I hoped to find.",
              "duration": 3.43,
              "pose": "talk"
            },
            {
              "type": "sound",
              "sound": "bells",
              "gain": 0.6
            },
            {
              "type": "line",
              "character": "Fortunato",
              "text": "Montresor! Have a drink with me — I am magnificent tonight.",
              "duration": 4.58,
              "pose": "shrug"
            }
          ],
          "camera": {
            "from": {
              "x": 0,
              "y": 0.46,
              "zoom": 0.95
            }
          }
        },
        {
          "id": "sc1-sh2",
          "beats": [
            {
              "type": "line",
              "character": "Montresor",
              "text": "You are. And I need your tongue, not your company. I have bought a full cask of rare Amontillado. At least — I think I have.",
              "duration": 10.35,
              "pose": "lean"
            },
            {
              "type": "line",
              "character": "Fortunato",
              "text": "You THINK? At carnival prices? My poor friend, you were robbed.",
              "duration": 4.58,
              "pose": "point"
            },
            {
              "type": "line",
              "character": "Montresor",
              "text": "Perhaps. No matter. Luchesi is coming tomorrow to taste it for me—",
              "duration": 4.97,
              "pose": "talk"
            }
          ],
          "camera": {
            "from": {
              "x": -0.22,
              "y": 0.46,
              "zoom": 1.25
            }
          }
        },
        {
          "id": "sc1-sh3",
          "beats": [
            {
              "type": "line",
              "character": "Fortunato",
              "text": "LUCHESI? Luchesi cannot tell Amontillado from soap. Where is this cask?",
              "duration": 4.58,
              "pose": "point"
            },
            {
              "type": "line",
              "character": "Montresor",
              "text": "In my family vaults. But they are cold, and deep, and you have a cough—",
              "duration": 6.12,
              "pose": "talk"
            },
            {
              "type": "line",
              "character": "Fortunato",
              "text": "A cough never killed a man with a thirst. Lead on!",
              "duration": 4.58,
              "pose": "point"
            },
            {
              "type": "sound",
              "sound": "bells",
              "gain": 0.7
            }
          ],
          "camera": {
            "from": {
              "x": 0.17,
              "y": 0.46,
              "zoom": 1.0
            },
            "to": {
              "x": 0.34,
              "y": 0.46,
              "zoom": 1.9
            }
          },
          "cues": [
            {
              "target": "Fortunato",
              "expression": "face_happy",
              "at": 0
            }
          ]
        }
      ],
      "music": {
        "sound": "carnival",
        "gain": 0.28,
        "loop": true
      }
    },
    {
