            {
              "type": "sound",
              "sound": "drip",
              "gain": 0.6
            },
            {
              "type": "line",
              "character": "Montresor",
              "text": "My family. A great house, and a long one. See how the nitre glitters — like little spiders' webs.",
              "duration": 7.66,
              "pose": "talk"
            }
          ],
          "camera": {
            "from": {
              "x": 0,
              "y": 0.46,
              "zoom": 0.95
            }
          },
          "cues": [
            {
              "target": "torch",
              "pose": "lit",
              "at": 0
            },
            {
              "target": "Fortunato",
              "expression": "face_suspicious",
              "at": 1.5
            }
          ]
        },
        {
          "id": "sc2-sh2",
          "beats": [
            {
              "type": "line",
              "character": "Fortunato",
              "text": "It bites at the chest. Hurh — this damp.",
              "duration": 3.81,
              "pose": "lean"
            },
            {
              "type": "line",
              "character": "Montresor",
              "text": "We will go back. Your health is precious — and there is always Luchesi—",
              "duration": 5.73,
              "pose": "talk"
            },
            {
              "type": "line",
              "character": "Fortunato",
              "text": "Enough! The cough is nothing. It shall not kill me. Walk on.",
              "duration": 4.97,
              "pose": "point"
            }
          ],
          "camera": {
            "from": {
              "x": 0.21,
              "y": 0.46,
              "zoom": 1.25
            }
          }
        },
        {
          "id": "sc2-sh3",
          "beats": [
            {
              "type": "line",
              "character": "Montresor",
              "text": "True. It shall not be the cough.",
              "duration": 3.04,
              "pose": "idle"
            },
            {
              "type": "pause",
              "duration": 0.5
            },
            {
              "type": "line",
              "character": "Fortunato",
              "text": "To the dead who rest around us!",
              "duration": 3.04,
              "pose": "shrug"
            },
            {
              "type": "sound",
              "sound": "bells",
              "gain": 0.6
            },
            {
              "type": "line",
              "character": "Montresor",
              "text": "And I — to your long life.",
              "duration": 3.04,
              "pose": "talk"
            },
            {
              "type": "pause",
              "duration": 0.4
            }
          ],
          "camera": {
            "from": {
