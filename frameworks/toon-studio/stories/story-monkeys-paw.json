      "shots": [
        {
          "id": "sc1-sh1",
          "beats": [
            {
              "type": "line",
              "character": "Mr White",
              "text": "Hark at the wind. A filthy night — and the sergeant-major an hour late.",
              "duration": 5.73,
              "pose": "lean"
            },
            {
              "type": "line",
              "character": "Morris",
              "text": "Late? I nearly did not come at all. Not with what I carry in this pocket.",
              "duration": 6.5,
              "pose": "idle"
            }
          ],
          "camera": {
            "from": {
              "x": 0,
              "y": 0.46,
              "zoom": 0.95
            }
          },
          "cues": [
            {
              "shake": 0.008,
              "at": 0,
              "duration": 1.0
            }
          ]
        },
        {
          "id": "sc1-sh2",
          "beats": [
            {
              "type": "line",
              "character": "Morris",
              "text": "Take it, then. But I threw it on the fire once, and I meant it to stay there.",
              "duration": 7.27,
              "pose": "lean"
            },
            {
              "type": "line",
              "character": "Mr White",
              "text": "A dried little paw. And this… grants wishes?",
              "duration": 3.43,
              "pose": "point"
            },
            {
              "type": "line",
              "character": "Morris",
              "text": "Three. An old fakir put a spell on it, to prove that fate rules our lives — and that those who interfere with fate do so to their sorrow.",
              "duration": 11.5,
              "pose": "talk"
            }
          ],
          "camera": {
            "from": {
              "x": 0.15,
              "y": 0.46,
              "zoom": 1.25
            }
          },
          "cues": [
            {
              "target": "paw",
              "pose": "idle",
              "at": 0
            }
          ]
        },
        {
          "id": "sc1-sh3",
          "beats": [
            {
              "type": "line",
              "character": "Mrs White",
              "text": "Has anyone wished on it before?",
              "duration": 2.66,
              "pose": "talk"
            },
            {
              "type": "line",
              "character": "Morris",
              "text": "The first owner had his three wishes. I don't know what the first two were. The third was for death.",
              "duration": 8.04,
              "pose": "idle"
            },
            {
              "type": "pause",
              "duration": 0.6
            },
            {
              "type": "line",
              "character": "Herbert",
              "text": "Well! Wish for two hundred pounds, father — that will just clear the house.",
              "duration": 5.73,
              "pose": "shrug"
            }
          ],
          "camera": {
            "from": {
              "x": -0.07,
              "y": 0.46,
              "zoom": 1.25
            }
          },
          "cues": [
            {
              "target": "Mrs White",
              "expression": "face_worried",
              "at": 2.5
            }
          ]
        },
        {
          "id": "sc1-sh4",
          "beats": [
            {
              "type": "line",
              "character": "Mr White",
              "text": "Very well. I wish for two hundred pounds.",
              "duration": 3.43,
              "pose": "point"
            },
            {
              "type": "sound",
              "sound": "sting_horror",
              "gain": 0.55
            },
            {
              "type": "line",
              "character": "Mr White",
              "text": "It moved! As I wished, it twisted in my hand — like a snake!",
              "duration": 5.73,
              "pose": "shrug"
            },
            {
              "type": "line",
              "character": "Herbert",
              "text": "Ha! Then I shall keep an eye out for the money on my way to work. Good night, all.",
              "duration": 7.66,
              "pose": "talk"
            }
          ],
          "camera": {
            "from": {
              "x": -0.25,
              "y": 0.46,
