    {
      "id": "sc3",
      "backdropID": "ts_bd_porch_night",
      "staging": [
        {
          "character": "Sam",
          "x": -0.35,
          "scale": 0.62,
          "facing": 1
        },
        {
          "character": "Bill",
          "x": 0.05,
          "scale": 0.62,
          "facing": -1
