        {
          "character": "Red Chief",
          "x": 0.55,
          "scale": 0.5,
          "facing": -1
        }
      ],
      "shots": [
        {
          "id": "sc3-sh1",
          "beats": [
            {
              "type": "sound",
              "sound": "owl",
              "gain": 0.5
            },
            {
              "type": "line",
              "character": "Sam",
              "text": "Dorset answered our note, Bill. I'll read it. 'Gentlemen: you bring Johnny home, and pay me two hundred and fifty dollars in cash, and I agree to take him off your hands.'",
              "duration": 12.66,
              "pose": "point"
            },
            {
              "type": "pause",
              "duration": 0.7
            },
            {
              "type": "line",
              "character": "Bill",
              "text": "…He wants US to pay HIM.",
              "duration": 2.66,
              "pose": "idle"
            }
          ],
          "camera": {
            "from": {
              "x": -0.24,
              "y": 0.46,
              "zoom": 1.25
            }
          },
          "cues": [
            {
              "target": "Bill",
              "expression": "face_surprised",
              "at": 9.0
            }
          ]
        },
        {
          "id": "sc3-sh2",
          "beats": [
            {
              "type": "line",
              "character": "Sam",
              "text": "'You had better come at night, for the neighbours believe he is lost, and I could not be responsible for what they would do to anybody bringing him back.'",
              "duration": 11.5,
              "pose": "talk"
            },
            {
              "type": "line",
              "character": "Bill",
              "text": "Sam. We have got the money. One more night of this boy and I am a broken man. You ain't going to let the chance go by, are you?",
              "duration": 11.5,
              "pose": "shrug"
            },
            {
              "type": "line",
              "character": "Sam",
              "text": "…No, Bill. No, I am not.",
              "duration": 2.66,
              "pose": "idle"
            }
          ],
          "camera": {
            "from": {
              "x": 0.05,
              "y": 0.46,
              "zoom": 2.1
            }
          },
          "cues": [
            {
              "target": "Bill",
              "expression": "face_worried",
              "at": 12.0
            }
          ]
        },
        {
          "id": "sc3-sh3",
          "beats": [
            {
              "type": "sound",
              "sound": "coins",
              "gain": 0.8
            },
            {
              "type": "line",
              "character": "Red Chief",
              "text": "You said we were going for a MIDNIGHT RAID! You PROMISED! I'll hold my breath! I'll scream!",
              "duration": 6.89,
              "pose": "point"
            },
            {
              "type": "line",
              "character": "Bill",
              "text": "Count it faster, Sam.",
              "duration": 1.89,
              "pose": "idle"
            },
            {
              "type": "sound",
              "sound": "coins",
              "gain": 0.7
            },
            {
              "type": "line",
              "character": "Sam",
              "text": "Two hundred and fifty. Paid in full. RUN, BILL.",
              "duration": 3.81,
              "pose": "point"
            },
            {
              "type": "sound",
              "sound": "whoosh",
              "gain": 0.8
            }
          ],
          "camera": {
            "from": {
              "x": 0.39,
              "y": 0.46,
              "zoom": 1.25
            }
          },
          "cues": [
            {
              "target": "Red Chief",
              "expression": "face_angry",
              "at": 1.0
            }
          ]
        },
        {
          "id": "sc3-sh4",
          "beats": [
            {
              "type": "line",
              "character": "Sam",
              "text": "Bill was the fattest man in Summit. But it was a mile and a half out of town before I caught up with him.",
              "duration": 9.58,
              "pose": "talk"
            },
            {
              "type": "pause",
              "duration": 0.8
            }
          ],
