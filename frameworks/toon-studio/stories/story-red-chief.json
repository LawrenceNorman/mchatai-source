  "scenes": [
    {
      "id": "sc1",
      "backdropID": "ts_bd_suburb_day",
      "staging": [
        {
          "character": "Sam",
          "x": -0.5,
          "scale": 0.62,
          "facing": 1
        },
        {
          "character": "Bill",
          "x": -0.15,
