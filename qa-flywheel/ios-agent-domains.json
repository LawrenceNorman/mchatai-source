  "intents": {
    "find": {
      "pick": 4,
      "templates": [
        "Find {s}.",
        "Look up {s}.",
        "Get me a list of {s}.",
        "Search the web for {s}.",
        "Can you dig up {s} for me?",
        "I need info on {s}.",
        "Show me {s}.",
        "Any good sources on {s}?"
      ],
      "expect": [
        "searchPapers"
      ],
      "minFound": 3,
      "wants": "A find request searches the web or the news, never the paper archives unless papers are asked for, and lists what it found."
    },
    "news": {
      "pick": 1,
      "templates": [
        "What's the latest news on {s}?",
        "Get me news about {s}.",
        "Any updates on {s} today?"
      ],
      "expect": [
        "searchPapers"
      ],
      "minFound": 3,
      "wants": "News on any subject or place comes from news sources and the outlets that cover it."
    },
    "summary": {
      "pick": 1,
      "templates": [
        "Find {s} and summarize the top three.",
        "Look up {s} and give me a short summary."
      ],
      "expect": [
        "searchPapers",
        "summarizeText"
      ],
      "wants": "Search, then a summary shown in the chat."
    },
    "writeup": {
      "pick": 1,
      "every": 2,
      "templates": [
        "Look up {s} and write it up in AI Write."
      ],
      "expect": [
        "searchPapers",
        "createDocument"
      ],
      "wants": "Search, then a document in AI Write."
    },
    "podcast": {
      "pick": 1,
      "every": 3,
      "templates": [
        "Get me the latest on {s} and make a short podcast episode about it."
      ],
      "expect": [
        "searchPapers",
        "createPodcast"
      ],
      "wants": "Search, then a podcast episode."
    },
    "agent": {
      "pick": 1,
      "templates": [
        "Make me an agent that keeps track of {a}.",
        "Create an agent for {a}."
      ],
      "expect": [
        "makeAgent"
      ],
      "forbid": [
        "searchPapers",
        "createPodcast",
        "createDocument"
      ],
      "wants": "A specialist agent is made, with sites found for it (an evaluation takes the first three); nothing else runs."
    },
    "agentSites": {
      "pick": 1,
      "every": 2,
      "templates": [
        "Make me {aLabel} agent that reads {site1} and {site2}."
      ],
      "expect": [
        "makeAgent"
      ],
      "forbid": [
        "searchPapers",
        "createPodcast"
      ],
      "wants": "An agent made from the sites the person named."
    },
    "followUp": {
      "pick": 1,
      "templates": [
        "Find {s}."
      ],
      "expect": [
        "searchPapers"
      ],
      "then": {
        "goal": "Tell me more about number 2.",
        "expect": [
          "readPaper"
        ],
        "forbid": [
          "searchPapers"
        ],
        "pick": 2
      },
      "wants": "A number after a list reads that item."
    },
    "papers": {
      "papersOnly": true,
      "pick": 2,
      "templates": [
        "Find recent research papers on {s}.",
        "What do recent studies say about {s}?"
      ],
      "expect": [
        "searchPapers"
      ],
      "needPapers": true,
      "wants": "Research questions reach the paper archives."
    },
    "explain": {
      "pick": 1,
      "templates": [
        "{explain}"
      ],
      "wants": "A question the model can answer from what it knows: answered, never a claimed search or action. Searching is allowed."
    }
  },
