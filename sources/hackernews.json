{
  "id": "hackernews",
  "title": "Hacker News",
  "summary": "Stories and discussion from the technology community, searched through Algolia.",
  "adapter": "json",
  "search": {
    "urlTemplate": "https://hn.algolia.com/api/v1/search?query={query}&tags=story&hitsPerPage={max}",
    "itemsPath": "hits"
  },
  "fields": {"id": "objectID", "title": "title", "summary": "story_text", "year": "created_at", "url": "url", "authors": "author"},
  "linkTemplate": "https://news.ycombinator.com/item?id={id}",
  "attribution": "Search by Algolia.",
  "_note": "No `item` lookup: reading an item reads the page the story links to."
}
