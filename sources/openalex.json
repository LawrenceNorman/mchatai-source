{
  "id": "openalex",
  "title": "OpenAlex",
  "summary": "An open index of scholarly works in every field.",
  "adapter": "json",
  "search": {
    "urlTemplate": "https://api.openalex.org/works?search={query}&per-page={max}&select=id,doi,title,publication_year,authorships,abstract_inverted_index,primary_location",
    "itemsPath": "results"
  },
  "item": {"urlTemplate": "https://api.openalex.org/works/{id}?select=id,doi,title,publication_year,authorships,abstract_inverted_index,primary_location"},
  "fields": {"id": "id", "title": "title", "summary": "abstract_inverted_index", "year": "publication_year", "url": "primary_location.landing_page_url", "authors": "authorships[].author.display_name"},
  "summaryFormat": "invertedIndex",
  "idStrip": ["https://openalex.org/"],
  "attribution": "Data from OpenAlex (CC0)."
}
