{
  "id": "semanticscholar",
  "title": "Semantic Scholar",
  "summary": "A scholarly search across every field, with abstracts.",
  "adapter": "json",
  "search": {
    "urlTemplate": "https://api.semanticscholar.org/graph/v1/paper/search?query={query}&limit={max}&fields=title,abstract,year,authors,url,externalIds",
    "itemsPath": "data"
  },
  "item": {"urlTemplate": "https://api.semanticscholar.org/graph/v1/paper/{id}?fields=title,abstract,year,authors,url,externalIds"},
  "fields": {"id": "paperId", "title": "title", "summary": "abstract", "year": "year", "url": "url", "authors": "authors[].name"},
  "attribution": "Data from Semantic Scholar.",
  "_note": "The keyless API shares one rate-limited pool and often answers 429; the adapter retries once and then says so plainly."
}
