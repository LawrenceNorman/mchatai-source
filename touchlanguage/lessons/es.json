 "version": 1,
 "language": "es",
 "_comment": "Lesson notes for a small on-device tutor model, chosen each turn (docs/LOCAL_LLM_SPECIALIST_EVIDENCE.md, LocalLLM/flywheel). levels[].notes is the grammar the reply should use; a topic is picked from the learner's last two lines by `match` (accent-free word prefixes) and contributes its focus line and up to `wordsPerTurn` words for the level. Rendered into {{lessonNotes}} of a catalog entry's instructions. Authored for this pack, CC0.",
 "wordsPerTurn": 10,
 "levels": {
  "novice": {
   "notes": "Grammar for A1–A2: present tense (soy, tengo, me gusta, vivo) and plans with voy a + verb. One or two sentences, each 3 to 8 words, and only one question: ¿Qué...?, ¿Dónde...?, ¿Te gusta...? or ¿Prefieres... o...?"
  },
  "intermediate": {
   "notes": "Grammar for B1: present, past (fui, comí, era) and future (voy a, iré). Natural sentences of up to 15 words. If the learner made one clear mistake, say that phrase correctly inside your reply without pointing it out."
  },
  "advanced": {
   "notes": "Level B2–C1: speak naturally; idioms are fine. At most three sentences."
  }
 },
