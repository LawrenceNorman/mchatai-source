{
  "version": 1,
  "_comment": "ASR and TTS ladders per target language, in the shape Phase VH (mchatai_macOS/docs/SPEECH_HARNESS_SPEC.md) proposes for harness/routing/asr.json and tts.json; when VH lands this file moves there and the applet's picker goes away. The first rung whose condition holds wins. `locales` are the ones iOS 26 can recognise on-device (SpeechTranscriber.supportedLocales, checked 2026-10-15). Cloud model ids live here and never in Swift. Conditions: always · locale.onDevice (the transcriber model is installed or downloadable) · user.cloudAllowed (spend guard allows the applet) · key.<provider> (the user has that key).",
  "languages": {
    "es": {
      "name": "Spanish",
      "nativeName": "Español",
      "nativeOf": [
        "es"
      ],
      "locales": [
        "es-MX",
        "es-ES",
        "es-US",
        "es-CL"
      ],
      "defaultLocale": "es-MX",
      "asr": [
        {
          "backend": "apple-sfspeech",
          "condition": "always"
        },
        {
          "backend": "apple-speechanalyzer",
          "condition": "locale.onDevice"
        },
        {
          "backend": "api:openai-transcribe",
          "model": "gpt-4o-mini-transcribe",
          "condition": "user.cloudAllowed AND key.openai"
        }
      ],
      "tts": [
        {
          "backend": "apple-avspeech",
          "condition": "always",
          "voiceByLocale": {
            "es-MX": "Paulina",
            "es-ES": "Mónica",
            "es-US": "Paulina",
            "es-CL": "Paulina"
          }
        },
        {
          "backend": "api:openai-tts",
          "model": "gpt-4o-mini-tts",
          "voice": "alloy",
          "condition": "user.cloudAllowed AND key.openai"
        }
      ]
    },
